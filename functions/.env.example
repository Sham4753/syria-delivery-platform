# Merchant fallback alerts. Keep secrets out of Firestore and source control.
# off (default), sms, whatsapp, or both
MERCHANT_ALERT_CHANNEL=off

# Twilio credentials (set with Firebase Functions environment configuration/secret manager).
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=replace-me
TWILIO_SMS_FROM=+10000000000
# Twilio WhatsApp sender, usually whatsapp:+14155238886 in sandbox.
TWILIO_WHATSAPP_FROM=whatsapp:+10000000000
