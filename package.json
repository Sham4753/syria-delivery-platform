{
  "name": "syria-delivery-local-dev",
  "private": true,
  "scripts": {
    "local": "bash ./dev.sh",
    "emulators:start": "firebase emulators:start --project syria-delivery-2026-majed --only auth,firestore,functions",
    "seed:emulator": "FIRESTORE_EMULATOR_HOST=127.0.0.1:8080 FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099 GCLOUD_PROJECT=syria-delivery-2026-majed node scripts/seed-emulator.js",
    "backfill:public-vendors": "FIRESTORE_EMULATOR_HOST=127.0.0.1:8080 GCLOUD_PROJECT=syria-delivery-2026-majed node scripts/backfill-public-vendors.js",
    "test:vendor-publication": "FIRESTORE_EMULATOR_HOST=127.0.0.1:8080 FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099 GCLOUD_PROJECT=syria-delivery-2026-majed node scripts/test-public-vendor-publication.js",
    "test:security-contract": "FIRESTORE_EMULATOR_HOST=127.0.0.1:8080 FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099 GCLOUD_PROJECT=syria-delivery-2026-majed node scripts/security-contract.test.js",
    "test:fixes": "node scripts/time-utils.test.js && node scripts/wallet-guard.test.js && node scripts/security-ops.test.js && node scripts/security-contract.test.js",
    "test:batch2": "node scripts/batch2-contract.test.js && node scripts/time-utils.test.js && node scripts/wallet-guard.test.js",
    "test:batch3": "node scripts/batch3-session-security.test.js && node scripts/batch2-contract.test.js && node scripts/security-contract.test.js",
    "test:batch4": "node scripts/batch4-firestore-performance.test.js && npm run test:batch3",
    "test:batch5": "node scripts/batch5-error-logging.test.js && npm run test:batch4"
  }
}
